{
  "schemaVersion": 1,
  "modelId": "example-detector",
  "version": "0.1.0",
  "artifact": {
    "file": "model.onnx",
    "format": "onnx",
    "sha256": "replace-with-create-manifest-output"
  },
  "input": {
    "name": "images",
    "shape": [1, 3, 640, 640],
    "layout": "NCHW",
    "color": "RGB",
    "dataType": "float32",
    "scale": 0.00392156862745098
  },
  "labels": ["person", "forklift"],
  "postprocessing": {
    "kind": "model-specific",
    "confidenceThreshold": 0.5,
    "nmsIouThreshold": 0.45
  },
  "runtime": {
    "preferred": "tensorrt-fp16",
    "engineBuildLocation": "target-device"
  }
}

